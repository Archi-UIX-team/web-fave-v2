{
  "name": "fave-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/vite-safe-realpath.cjs ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node --require ./scripts/vite-safe-realpath.cjs ./node_modules/vite/bin/vite.js build --minify false",
    "preview": "node --require ./scripts/vite-safe-realpath.cjs ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test:browser": "node --require ./scripts/vite-safe-realpath.cjs --test --test-concurrency=1 tests/hotels-booking.test.mjs"
  },
  "dependencies": {
    "@fontsource/comfortaa": "^5.2.6",
    "@fontsource/nunito": "^5.2.6"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "vite": "^7.1.3"
  }
}
